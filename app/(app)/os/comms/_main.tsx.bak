
// ─── Main Comms Page ───────────────────────────────────────────────────────────

export default function OSCommsPage() {
  const [channels, setChannels] = useState<Channel[]>([])
  const [dms, setDms] = useState<Channel[]>([])
  const [teamMembers, setTeamMembers] = useState<ByredUser[]>([])
  const [presence, setPresence] = useState<Map<string, Presence>>(new Map())
  const [myUserId, setMyUserId] = useState<string | null>(null)
  const [myPresenceStatus, setMyPresenceStatus] = useState<PresenceStatus>("online")

  const [activeChannelId, setActiveChannelId] = useState<string | null>(null)
  const [messages, setMessages] = useState<Message[]>([])
  const [draft, setDraft] = useState("")
  const [replyTo, setReplyTo] = useState<Message | null>(null)
  const [search, setSearch] = useState("")

  const [loadingChannels, setLoadingChannels] = useState(true)
  const [loadingMessages, setLoadingMessages] = useState(false)
  const [sending, setSending] = useState(false)
  const [unread, setUnread] = useState<Set<string>>(new Set())
  const [atBottom, setAtBottom] = useState(true)

  const [showNewChannel, setShowNewChannel] = useState(false)
  const [showNewDM, setShowNewDM] = useState(false)
  const [showSearch, setShowSearch] = useState(false)

  const bottomRef = useRef<HTMLDivElement>(null)
  const scrollRef = useRef<HTMLDivElement>(null)
  const inputRef = useRef<HTMLTextAreaElement>(null)
  const supabase = createClient()

  const activeChannel = useMemo(
    () => [...channels, ...dms].find(c => c.id === activeChannelId),
    [channels, dms, activeChannelId]
  )

  useEffect(() => {
    supabase.auth.getUser().then(async ({ data: { user } }) => {
      if (!user) return
      const { data } = await supabase.from("byred_users").select("id").eq("auth_user_id", user.id).maybeSingle()
      if (data) setMyUserId((data as { id: string }).id)
    })
    fetch("/api/os/comms/channels").then(r => r.json()).then(d => {
      const all: Channel[] = d.channels ?? []
      setChannels(all.filter(c => c.type !== "direct"))
      setDms(all.filter(c => c.type === "direct"))
      const first = all.find(c => c.type !== "direct")
      if (first) setActiveChannelId(first.id)
    }).finally(() => setLoadingChannels(false))
    supabase.from("byred_users").select("id, name, email, avatar_url").eq("active", true)
      .then(({ data }) => setTeamMembers((data ?? []) as ByredUser[]))
    fetch("/api/os/comms/presence").then(r => r.json()).then(d => {
      const map = new Map<string, Presence>()
      for (const p of (d.presence ?? [])) map.set(p.user_id, p)
      setPresence(map)
    })
    fetch("/api/os/comms/presence", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ status: "online" }),
    })
    const handleUnload = () => navigator.sendBeacon("/api/os/comms/presence", JSON.stringify({ status: "offline" }))
    window.addEventListener("beforeunload", handleUnload)
    return () => window.removeEventListener("beforeunload", handleUnload)
  }, []) // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    if (!activeChannelId) return
    setLoadingMessages(true); setMessages([])
    fetch(`/api/os/comms/channels/${activeChannelId}/messages`)
      .then(r => r.json()).then(d => setMessages(d.messages ?? []))
      .finally(() => setLoadingMessages(false))
  }, [activeChannelId])

  useEffect(() => {
    if (atBottom) bottomRef.current?.scrollIntoView({ behavior: "smooth" })
  }, [messages, atBottom])

  useEffect(() => {
    if (!activeChannelId) return
    const ch = supabase.channel(`msg-${activeChannelId}`)
      .on("postgres_changes", { event: "INSERT", schema: "public", table: "os_messages", filter: `channel_id=eq.${activeChannelId}` },
        async payload => {
          const { data } = await supabase.from("os_messages")
            .select(`id, body, created_at, updated_at, edited, reply_to_id, user_id,
                     byred_users:user_id ( id, name, email, avatar_url ),
                     os_message_reactions ( id, user_id, emoji )`)
            .eq("id", payload.new.id).single()
          if (data) setMessages(prev => [...prev, data as Message])
        })
      .on("postgres_changes", { event: "DELETE", schema: "public", table: "os_messages" },
        payload => setMessages(prev => prev.filter(m => m.id !== payload.old.id)))
      .on("postgres_changes", { event: "UPDATE", schema: "public", table: "os_messages" },
        payload => setMessages(prev => prev.map(m =>
          m.id === payload.new.id ? { ...m, body: payload.new.body, edited: payload.new.edited } : m)))
      .subscribe()
    return () => { supabase.removeChannel(ch) }
  }, [activeChannelId]) // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    if (!activeChannelId) return
    const ch = supabase.channel(`reactions-${activeChannelId}`)
      .on("postgres_changes", { event: "*", schema: "public", table: "os_message_reactions" },
        async payload => {
          const msgId = ((payload.new ?? payload.old) as { message_id?: string }).message_id
          if (!msgId) return
          const { data } = await supabase.from("os_message_reactions").select("id, user_id, emoji").eq("message_id", msgId)
          setMessages(prev => prev.map(m => m.id === msgId ? { ...m, os_message_reactions: (data ?? []) as Reaction[] } : m))
        })
      .subscribe()
    return () => { supabase.removeChannel(ch) }
  }, [activeChannelId]) // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    const ch = supabase.channel("unread-watch")
      .on("postgres_changes", { event: "INSERT", schema: "public", table: "os_messages" }, payload => {
        const cid = (payload.new as { channel_id: string }).channel_id
        if (cid !== activeChannelId) setUnread(prev => new Set([...prev, cid]))
      }).subscribe()
    return () => { supabase.removeChannel(ch) }
  }, [activeChannelId]) // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    const ch = supabase.channel("presence-watch")
      .on("postgres_changes", { event: "*", schema: "public", table: "os_user_presence" }, payload => {
        const p = payload.new as Presence
        setPresence(prev => new Map(prev).set(p.user_id, p))
      }).subscribe()
    return () => { supabase.removeChannel(ch) }
  }, []) // eslint-disable-line react-hooks/exhaustive-deps

  function handleScroll() {
    const el = scrollRef.current; if (!el) return
    setAtBottom(el.scrollHeight - el.scrollTop - el.clientHeight < 80)
  }

  async function sendMessage() {
    if (!draft.trim() || !activeChannelId || sending) return
    setSending(true); const body = draft.trim(); setDraft("")
    try {
      const res = await fetch(`/api/os/comms/channels/${activeChannelId}/messages`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ body, reply_to_id: replyTo?.id ?? null }),
      })
      if (!res.ok) { toast.error("Failed to send"); setDraft(body) }
      else setReplyTo(null)
    } catch { toast.error("Failed to send"); setDraft(body) }
    finally { setSending(false) }
  }

  async function handleEdit(message: Message) {
    await fetch(`/api/os/comms/channels/${activeChannelId}/messages/${message.id}`, {
      method: "PATCH", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ body: message.body }),
    })
  }

  async function handleDelete(messageId: string) {
    const res = await fetch(`/api/os/comms/channels/${activeChannelId}/messages/${messageId}`, { method: "DELETE" })
    if (!res.ok) toast.error("Failed to delete message")
  }

  async function handleReact(messageId: string, emoji: string) {
    await fetch(`/api/os/comms/channels/${activeChannelId}/messages/${messageId}/reactions`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ emoji }),
    })
  }

  function handlePin(messageId: string) { toast.success("Message pinned"); void messageId }

  async function updateMyPresence(status: PresenceStatus) {
    setMyPresenceStatus(status)
    await fetch("/api/os/comms/presence", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ status }),
    })
  }

  const handleChannelSelect = useCallback((id: string) => {
    setActiveChannelId(id); setReplyTo(null)
    setUnread(prev => { const n = new Set(prev); n.delete(id); return n })
  }, [])

  const filteredMessages = useMemo(() =>
    search ? messages.filter(m => m.body.toLowerCase().includes(search.toLowerCase())) : messages,
  [messages, search])

  const dmName = (channel: Channel) => {
    if (channel.type !== "direct") return channel.name
    const other = channel.name.split(", ").find(n => teamMembers.find(u => u.name === n && u.id !== myUserId))
    return other ?? channel.name
  }

  return (
    <div className="flex h-[calc(100vh-64px)] overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950">

      {/* ── Sidebar ── */}
      <aside className="w-56 shrink-0 flex flex-col border-r border-zinc-800 bg-zinc-900/50 overflow-y-auto">
        <div className="px-3 pt-4 pb-3 border-b border-zinc-800/60">
          <div className="flex items-center gap-2">
            <div className="relative">
              <OSAvatar userId={myUserId ?? undefined} size="sm" />
              <span className={cn("absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-zinc-900", STATUS_COLOR[myPresenceStatus])} />
            </div>
            <span className="text-xs font-medium text-zinc-300 truncate flex-1">You</span>
            <select value={myPresenceStatus} onChange={e => updateMyPresence(e.target.value as PresenceStatus)}
              className="bg-transparent text-[10px] text-zinc-600 outline-none cursor-pointer">
              {(Object.keys(STATUS_LABEL) as PresenceStatus[]).map(s => (
                <option key={s} value={s}>{STATUS_LABEL[s]}</option>
              ))}
            </select>
          </div>
        </div>

        <div className="px-3 pt-4">
          <div className="flex items-center justify-between mb-2">
            <span className="text-[10px] font-semibold text-zinc-600 uppercase tracking-widest">Channels</span>
            <button onClick={() => setShowNewChannel(true)} className="text-zinc-600 hover:text-zinc-300 transition-colors"><Plus className="w-3.5 h-3.5" strokeWidth={2} /></button>
          </div>
          {loadingChannels
            ? <div className="flex justify-center py-4"><Loader2 className="w-4 h-4 text-zinc-700 animate-spin" /></div>
            : <div className="space-y-0.5">
                {channels.map(ch => (
                  <button key={ch.id} onClick={() => handleChannelSelect(ch.id)}
                    className={cn("w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm transition-colors text-left",
                      activeChannelId === ch.id ? "bg-white/10 text-white" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.04]")}>
                    <Hash className="w-3.5 h-3.5 shrink-0" strokeWidth={2} />
                    <span className="truncate">{ch.name}</span>
                    {unread.has(ch.id) && activeChannelId !== ch.id && <span className="ml-auto w-2 h-2 rounded-full bg-[#D7261E] shrink-0" />}
                  </button>
                ))}
              </div>}
        </div>

        <div className="px-3 pt-5 pb-4">
          <div className="flex items-center justify-between mb-2">
            <span className="text-[10px] font-semibold text-zinc-600 uppercase tracking-widest">Direct Messages</span>
            <button onClick={() => setShowNewDM(true)} className="text-zinc-600 hover:text-zinc-300 transition-colors"><Plus className="w-3.5 h-3.5" strokeWidth={2} /></button>
          </div>
          <div className="space-y-0.5">
            {dms.length === 0 && <p className="text-[11px] text-zinc-700 px-2 py-1">No direct messages yet</p>}
            {dms.map(dm => {
              const otherName = dmName(dm)
              const otherMember = teamMembers.find(u => u.name === otherName)
              const pres = otherMember ? presence.get(otherMember.id) : null
              return (
                <button key={dm.id} onClick={() => handleChannelSelect(dm.id)}
                  className={cn("w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm transition-colors text-left",
                    activeChannelId === dm.id ? "bg-white/10 text-white" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.04]")}>
                  <div className="relative shrink-0">
                    <OSAvatar userId={otherMember?.id} fallbackName={otherName} size="xs" />
                    <PresenceDot status={pres?.status ?? "offline"} className="absolute -bottom-0.5 -right-0.5 w-2 h-2 border border-zinc-900" />
                  </div>
                  <span className="truncate">{otherName}</span>
                  {unread.has(dm.id) && activeChannelId !== dm.id && <span className="ml-auto w-2 h-2 rounded-full bg-[#D7261E] shrink-0" />}
                </button>
              )
            })}
          </div>
        </div>

        {teamMembers.length > 0 && (
          <div className="px-3 pt-2 pb-4 border-t border-zinc-800/60 mt-auto">
            <div className="flex items-center gap-1.5 mb-2">
              <Users className="w-3 h-3 text-zinc-700" strokeWidth={2} />
              <span className="text-[10px] font-semibold text-zinc-600 uppercase tracking-widest">Team</span>
            </div>
            <div className="space-y-1.5">
              {teamMembers.filter(u => u.id !== myUserId).map(u => {
                const pres = presence.get(u.id)
                return (
                  <div key={u.id} className="flex items-center gap-2">
                    <div className="relative shrink-0">
                      <OSAvatar userId={u.id} fallbackName={u.name} size="xs" />
                      <PresenceDot status={pres?.status ?? "offline"} className="absolute -bottom-0.5 -right-0.5 w-2 h-2 border border-zinc-900" />
                    </div>
                    <span className="text-xs text-zinc-500 truncate">{u.name}</span>
                    <button onClick={() => setShowNewDM(true)} className="ml-auto text-zinc-700 hover:text-zinc-400 transition-colors shrink-0">
                      <MessageCircle className="w-3 h-3" strokeWidth={2} />
                    </button>
                  </div>
                )
              })}
            </div>
          </div>
        )}
      </aside>

      {/* ── Message Pane ── */}
      <div className="flex-1 flex flex-col min-w-0">
        {activeChannel && (
          <div className="flex items-center gap-3 px-5 py-3 border-b border-zinc-800 shrink-0">
            {activeChannel.type === "direct" ? <MessageCircle className="w-4 h-4 text-zinc-500" strokeWidth={2} /> : <Hash className="w-4 h-4 text-zinc-500" strokeWidth={2} />}
            <span className="font-semibold text-white text-sm">{activeChannel.type === "direct" ? dmName(activeChannel) : activeChannel.name}</span>
            {activeChannel.description && <span className="text-zinc-600 text-xs truncate hidden sm:block">— {activeChannel.description}</span>}
            <div className="ml-auto">
              <button onClick={() => setShowSearch(v => !v)}
                className={cn("p-1.5 rounded-lg transition-colors", showSearch ? "text-white bg-white/10" : "text-zinc-500 hover:text-zinc-300")}>
                <Search className="w-4 h-4" strokeWidth={2} />
              </button>
            </div>
          </div>
        )}

        {showSearch && (
          <div className="px-4 py-2 border-b border-zinc-800 flex items-center gap-2 shrink-0">
            <Search className="w-3.5 h-3.5 text-zinc-600 shrink-0" strokeWidth={2} />
            <input autoFocus value={search} onChange={e => setSearch(e.target.value)}
              placeholder="Search messages…"
              className="flex-1 bg-transparent text-sm text-zinc-200 placeholder-zinc-600 outline-none" />
            {search && <button onClick={() => setSearch("")} className="text-zinc-600 hover:text-zinc-400"><X className="w-3.5 h-3.5" /></button>}
          </div>
        )}

        <div ref={scrollRef} onScroll={handleScroll} className="flex-1 overflow-y-auto py-2">
          {loadingMessages
            ? <div className="flex items-center justify-center h-full"><Loader2 className="w-5 h-5 text-zinc-700 animate-spin" /></div>
            : !activeChannel
            ? <div className="flex flex-col items-center justify-center h-full gap-3">
                <MessageSquare className="w-10 h-10 text-zinc-800" strokeWidth={1} />
                <p className="text-zinc-600 text-sm">Select a channel or DM</p>
              </div>
            : filteredMessages.length === 0
            ? <div className="flex flex-col items-center justify-center h-full gap-2 px-6 text-center">
                {activeChannel.type === "direct"
                  ? <><MessageCircle className="w-10 h-10 text-zinc-800" strokeWidth={1} />
                      <p className="text-zinc-400 font-medium">Start a conversation</p>
                      <p className="text-zinc-600 text-sm">Messages are private to participants.</p></>
                  : <><Hash className="w-10 h-10 text-zinc-800" strokeWidth={1} />
                      <p className="text-zinc-400 font-medium">#{activeChannel.name}</p>
                      <p className="text-zinc-600 text-sm">{activeChannel.description ?? "Start the conversation."}</p></>}
              </div>
            : filteredMessages.map((msg, i) => (
                <MessageRow key={msg.id} message={msg} messages={messages}
                  showHead={showHeader(filteredMessages, i)} myUserId={myUserId}
                  onReply={m => { setReplyTo(m); inputRef.current?.focus() }}
                  onDelete={handleDelete} onEdit={handleEdit}
                  onReact={handleReact} onPin={handlePin} />
              ))
          }
          <div ref={bottomRef} />
        </div>

        {!atBottom && (
          <div className="relative">
            <button onClick={() => { setAtBottom(true); bottomRef.current?.scrollIntoView({ behavior: "smooth" }) }}
              className="absolute bottom-2 right-6 flex items-center gap-1.5 px-3 py-1.5 bg-zinc-800 border border-zinc-700 rounded-full text-xs text-zinc-300 shadow-lg hover:bg-zinc-700 transition-colors">
              <ChevronDown className="w-3.5 h-3.5" strokeWidth={2} />Latest
            </button>
          </div>
        )}

        {activeChannel && (
          <div className="px-4 pb-4 pt-2 shrink-0">
            {replyTo && (
              <div className="flex items-center gap-2 mb-1.5 px-3 py-1.5 bg-zinc-800/60 border border-zinc-700 rounded-lg text-xs text-zinc-400">
                <Reply className="w-3 h-3 text-zinc-600 shrink-0" strokeWidth={2} />
                <span className="font-medium text-zinc-300">{replyTo.byred_users?.name}</span>
                <span className="truncate">{replyTo.body.slice(0, 60)}{replyTo.body.length > 60 ? "…" : ""}</span>
                <button onClick={() => setReplyTo(null)} className="ml-auto text-zinc-600 hover:text-zinc-400 shrink-0"><X className="w-3 h-3" /></button>
              </div>
            )}
            <div className="flex items-end gap-2 bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 focus-within:border-zinc-500 transition-colors">
              <button className="text-zinc-600 hover:text-zinc-400 transition-colors shrink-0 mb-0.5" title="Mention (@)">
                <AtSign className="w-4 h-4" strokeWidth={2} />
              </button>
              <textarea ref={inputRef} value={draft} onChange={e => setDraft(e.target.value)}
                onKeyDown={e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage() } }}
                placeholder={activeChannel.type === "direct" ? `Message ${dmName(activeChannel)}` : `Message #${activeChannel.name}`}
                rows={1}
                className="flex-1 bg-transparent text-sm text-zinc-200 placeholder-zinc-600 outline-none resize-none leading-relaxed max-h-36 overflow-y-auto"
                onInput={e => {
                  const t = e.currentTarget; t.style.height = "auto"
                  t.style.height = Math.min(t.scrollHeight, 144) + "px"
                }}
              />
              <button onClick={sendMessage} disabled={!draft.trim() || sending}
                className="text-zinc-500 hover:text-[#D7261E] disabled:opacity-30 transition-colors shrink-0 mb-0.5">
                {sending ? <Loader2 className="w-4 h-4 animate-spin" strokeWidth={2} /> : <Send className="w-4 h-4" strokeWidth={2} />}
              </button>
            </div>
            <p className="text-[11px] text-zinc-700 mt-1 px-1">Enter to send · Shift+Enter for new line</p>
          </div>
        )}
      </div>

      {showNewChannel && (
        <NewChannelModal onClose={() => setShowNewChannel(false)}
          onCreated={ch => { setChannels(prev => [...prev, ch]); setActiveChannelId(ch.id) }} />
      )}
      {showNewDM && (
        <NewDMModal teamMembers={teamMembers} myUserId={myUserId}
          onClose={() => setShowNewDM(false)}
          onOpen={ch => {
            setDms(prev => prev.find(d => d.id === ch.id) ? prev : [...prev, ch])
            setActiveChannelId(ch.id)
          }} />
      )}
    </div>
  )
}
