# ByRedLLC Daily OS environment template.
# Copy to .env.local for local development. Never commit .env.local or real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing optional AI providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional complementary providers.
# Core OS task/dashboard flows must still work when these are blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ZAI_API_KEY=
GLM_MODEL=glm-5.2

# Provider controls.
# Keep primary as existing until a feature is intentionally moved.
OS_AI_PRIMARY_PROVIDER=anthropic
OS_AI_COMPLEMENTARY_PROVIDERS=gemini,deepseek,glm
